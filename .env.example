# Copy to .env.local and fill in. Never commit .env.local.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=paste_sandbox_client_id
PAYPAL_CLIENT_SECRET=paste_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Same Client ID, exposed to the browser for the PayPal button (this one is public, that's fine)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=paste_sandbox_client_id

# Google Gemini key (aistudio.google.com). Without it, a built-in template compiler is used.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Google PageSpeed Insights API key (higher quota). Works without it at low volume.
PAGESPEED_API_KEY=

# Optional: webhook ID from the sandbox app (Apps & Credentials > your app > Webhooks), for signature-verified webhooks.
# Webhook URL to register: https://<your-app>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
